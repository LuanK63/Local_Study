/* =====================================================================
   Local Study RAG Agent — Global Stylesheet (Catppuccin Mocha — Refined)
   8px Grid System  |  Inter Font  |  Softer Palette
   ===================================================================== */

/* ── Reset / Base ─────────────────────────────────────────────────── */
* {
    outline: none;
}
QWidget {
    background-color: #1a1b2e;
    color: #cdd6f4;
    font-family: "Inter", "Segoe UI", "Arial", sans-serif;
    font-size: 11pt;
}
QWidget:disabled {
    color: #4a4d64;
}

/* ── Main Window ─────────────────────────────────────────────────── */
QMainWindow {
    background-color: #1a1b2e;
}

/* ── Sidebar ─────────────────────────────────────────────────────── */
QWidget#Sidebar {
    background-color: #14152a;
    border-right: 1px solid #2a2b3d;
}

QLabel#AppTitle {
    color: #cba6f7;
    padding: 4px 0px;
    font-size: 16pt;
    font-weight: bold;
    letter-spacing: 0.5px;
}

QLabel#SectionLabel {
    color: #5a5d78;
    font-size: 9pt;
    padding: 4px 0;
    text-transform: uppercase;
    letter-spacing: 1.5px;
}

QLabel#FooterLabel {
    color: #3a3b52;
    font-size: 8pt;
    padding: 4px 0;
    line-height: 1.4;
}

QLabel#SectionHeader {
    color: #cba6f7;
    font-size: 13pt;
    font-weight: bold;
    padding: 0 0 8px 0;
}

QLabel#PlaceholderInfo {
    color: #5a5d78;
}

/* ── Nav / Push Buttons ──────────────────────────────────────────── */
QPushButton {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    color: #b0b4cc;
    text-align: left;
    padding: 0 12px;
}
QPushButton:hover {
    background-color: #22243a;
    color: #cdd6f4;
}
QPushButton:checked {
    background-color: #1f2038;
    color: #cba6f7;
    font-weight: bold;
    border-left: 3px solid #cba6f7;
    border-radius: 0px 8px 8px 0px;
}
QPushButton:pressed {
    background-color: #2a2c44;
    color: #cdd6f4;
}
QPushButton:disabled {
    color: #3a3b52;
    background-color: transparent;
}

/* Action buttons (non-nav) — keep center alignment */
QPushButton[text="Hỏi"],
QPushButton[text="Tạo code"],
QPushButton[text="Giải thích"],
QPushButton[text="Phân tích Complexity"],
QPushButton[text="Tạo Simulation"],
QPushButton[text="Ra đề"],
QPushButton[text="Nộp bài"],
QPushButton[text="Tạo Flashcard"],
QPushButton[text="Tạo Quiz"],
QPushButton[text="Tạo Lộ Trình Học Tập"],
QPushButton[text="Quét Lịch Sử Học Tập"] {
    text-align: center;
    border-left: none;
    border-radius: 8px;
}

/* ── ComboBox ────────────────────────────────────────────────────── */
QComboBox {
    background-color: #2a2b3d;
    border: 1px solid #3a3c52;
    border-radius: 8px;
    padding: 6px 12px;
    color: #cdd6f4;
    selection-background-color: #cba6f7;
    selection-color: #1a1b2e;
}
QComboBox:hover {
    border-color: #9d8abf;
}
QComboBox:focus {
    border-color: #89b4fa;
}
QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #8a8daa;
    margin-right: 8px;
}
QComboBox QAbstractItemView {
    background-color: #2a2b3d;
    border: 1px solid #3a3c52;
    border-radius: 8px;
    selection-background-color: #cba6f7;
    selection-color: #1a1b2e;
    padding: 4px;
    outline: none;
}

/* ── LineEdit / TextEdit / PlainTextEdit ─────────────────────────── */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #2a2b3d;
    border: 1.5px solid #3a3c52;
    border-radius: 10px;
    color: #cdd6f4;
    padding: 6px 12px;
    selection-background-color: #cba6f7;
    selection-color: #1a1b2e;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #89b4fa;
    background-color: #2e2f44;
}
QLineEdit:hover, QTextEdit:hover, QPlainTextEdit:hover {
    border-color: #4e5068;
}

/* ── SpinBox ─────────────────────────────────────────────────────── */
QSpinBox {
    background-color: #2a2b3d;
    border: 1px solid #3a3c52;
    border-radius: 8px;
    color: #cdd6f4;
    padding: 4px 8px;
}
QSpinBox:focus { border-color: #89b4fa; }
QSpinBox::up-button, QSpinBox::down-button {
    background: #3a3c52;
    border: none;
    border-radius: 4px;
    width: 16px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background: #4e5068;
}

/* ── Dividers ────────────────────────────────────────────────────── */
QFrame#Divider {
    background-color: #2a2b3d;
    max-height: 1px;
}
QFrame#VDivider {
    background-color: #2a2b3d;
    max-width: 1px;
}

/* ── Stacked / Scroll area ───────────────────────────────────────── */
QStackedWidget {
    background-color: #1a1b2e;
}
QScrollArea {
    background-color: transparent;
    border: none;
}

/* ── Table Widget ────────────────────────────────────────────────── */
QTableWidget {
    background-color: #1a1b2e;
    color: #cdd6f4;
    gridline-color: #2a2b3d;
    border: 1px solid #2a2b3d;
    border-radius: 8px;
    selection-background-color: #3a3c52;
}
QTableWidget::item:selected {
    background-color: #3a3c52;
    color: #cdd6f4;
}
QHeaderView::section {
    background-color: #14152a;
    color: #8a8daa;
    padding: 8px 8px;
    border: none;
    border-bottom: 1px solid #2a2b3d;
    font-weight: bold;
    font-size: 10pt;
}

/* ── Tabs (sub-tabs inside Code module) ──────────────────────────── */
QTabWidget::pane {
    background: #1a1b2e;
    border: 1px solid #2a2b3d;
    border-radius: 8px;
}
QTabBar::tab {
    background: #14152a;
    color: #8a8daa;
    border: 1px solid #2a2b3d;
    padding: 8px 24px;
    border-radius: 6px;
    margin-right: 4px;
}
QTabBar::tab:selected {
    background: #2a2b3d;
    color: #cba6f7;
    border-color: #cba6f7;
    font-weight: bold;
}
QTabBar::tab:hover:!selected {
    background: #1e2038;
    color: #cdd6f4;
}

/* ── Progress Bar ────────────────────────────────────────────────── */
QProgressBar {
    background-color: #2a2b3d;
    border: none;
    border-radius: 4px;
    height: 8px;
    text-align: center;
}
QProgressBar::chunk {
    background-color: #cba6f7;
    border-radius: 4px;
}

/* ── Slider ──────────────────────────────────────────────────────── */
QSlider::groove:horizontal {
    background: #2a2b3d;
    height: 4px;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background: #cba6f7;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}
QSlider::handle:horizontal:hover {
    background: #d4b5ff;
}
QSlider::sub-page:horizontal {
    background: #89b4fa;
    border-radius: 2px;
}

/* ── Scrollbar ───────────────────────────────────────────────────── */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    border-radius: 5px;
    margin: 4px 1px;
}
QScrollBar::handle:vertical {
    background: #3a3c52;
    border-radius: 5px;
    min-height: 32px;
}
QScrollBar::handle:vertical:hover {
    background: #5a5d78;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    border-radius: 5px;
    margin: 1px 4px;
}
QScrollBar::handle:horizontal {
    background: #3a3c52;
    border-radius: 5px;
    min-width: 32px;
}
QScrollBar::handle:horizontal:hover {
    background: #5a5d78;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ── Radio Button ────────────────────────────────────────────────── */
QRadioButton {
    spacing: 8px;
    color: #cdd6f4;
    padding: 6px 8px;
    border-radius: 8px;
}
QRadioButton:hover {
    background-color: #22243a;
}
QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border: 2px solid #4e5068;
    background: #1a1b2e;
}
QRadioButton::indicator:checked {
    background: #cba6f7;
    border-color: #cba6f7;
}

/* ── Tooltip ─────────────────────────────────────────────────────── */
QToolTip {
    background-color: #2a2b3d;
    color: #cdd6f4;
    border: 1px solid #3a3c52;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 10pt;
}

/* ── Special Output Display ──────────────────────────────────────── */
QTextEdit#OutputDisplay {
    background-color: #14152a;
    border: 1px solid #2a2b3d;
    border-radius: 10px;
    padding: 16px;
    color: #cdd6f4;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 11pt;
    line-height: 1.6;
}

/* ── Code Editor ─────────────────────────────────────────────────── */
QPlainTextEdit#CodeEditor {
    background-color: #14152a;
    border: 1px solid #3a3c52;
    border-radius: 8px;
    color: #cdd6f4;
    padding: 12px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 12pt;
    selection-background-color: #3a3c52;
    line-height: 1.6;
}
QPlainTextEdit#CodeEditor:focus {
    border-color: #89b4fa;
}

/* ── Citation Text Browser ───────────────────────────────────────── */
QTextBrowser#CitationDisplay {
    background-color: #1a1b2e;
    border: none;
    color: #cdd6f4;
    padding: 4px;
    font-family: "Inter", "Segoe UI", sans-serif;
    font-size: 11pt;
    line-height: 1.7;
    selection-background-color: #3a3c52;
}

/* ── Chat Bubble frame ───────────────────────────────────────────── */
QFrame#ChatBubble {
    background: transparent;
}

/* ── Sources Panel ───────────────────────────────────────────────── */
QFrame#SourceCard {
    background: #14152a;
    border: 1px solid #2a2b3d;
    border-radius: 10px;
}
QFrame#SourceCard:hover {
    border-color: #4e5068;
    background: #191a30;
}
